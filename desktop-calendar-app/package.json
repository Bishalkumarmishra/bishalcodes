{
  "name": "nepali-desktop-calendar",
  "version": "1.4.0",
  "description": "Premium offline Nepali Calendar and Date Converter widget for Windows",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "package": "electron-builder --win --x64",
    "build-appx": "electron-builder --win appx --x64"
  },
  "build": {
    "appId": "com.bishal.nepalicalendar",
    "productName": "Nepali Calendar",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis",
        "appx"
      ],
      "icon": "icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Nepali Calendar"
    },
    "appx": {
      "identityName": "BishalCodes.NepaliDesktopCalendar",
      "publisher": "CN=DA9E5952-AE08-4113-9120-A104B69C70B7",
      "publisherDisplayName": "Bishal Codes",
      "applicationId": "com.bishal.nepalicalendar",
      "displayName": "Nepali Desktop Calendar"
    }
  },
  "dependencies": {
    "nepali-date-converter": "^3.4.0"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  }
}
